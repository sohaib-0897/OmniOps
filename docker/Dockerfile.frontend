FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
# Apply compatible Alpine OpenSSL security fixes and omit the package installer
# (including its vulnerable archive tooling) from the standalone runtime.
RUN apk upgrade --no-cache libssl3 libcrypto3 \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
    && addgroup -S -g 10001 omniops && adduser -S -u 10001 -G omniops omniops
COPY --from=builder --chown=omniops:omniops /app/.next/standalone ./
COPY --from=builder --chown=omniops:omniops /app/.next/static ./.next/static
COPY --from=builder --chown=omniops:omniops /app/public ./public
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:3000/
CMD ["node", "server.js"]
