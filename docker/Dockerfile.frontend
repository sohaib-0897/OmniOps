FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
# The lockfile still governs every version and integrity hash; the cache only
# keeps rebuilds from re-downloading tarballs over the network.
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
RUN npm run build
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
# The base image carries current OpenSSL fixes (verified by image scan), so no
# package mutation happens at build time. Omit the package installers (and
# their bundled archive/network tooling) from the standalone runtime.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v* \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -S -g 10001 omniops && adduser -S -u 10001 -G omniops omniops
COPY --from=builder --chown=omniops:omniops /app/.next/standalone ./
COPY --from=builder --chown=omniops:omniops /app/.next/static ./.next/static
COPY --from=builder --chown=omniops:omniops /app/public ./public
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:3000/
CMD ["node", "server.js"]
