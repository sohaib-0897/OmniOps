# OmniOps Environment Variables

# App Environment
ENVIRONMENT=development
DEBUG=False
PROJECT_NAME="OmniOps"
# In production, generate a secure secret: `openssl rand -hex 32`
SECRET_KEY=replace_with_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://omniops:omniops_secure_pass@localhost:5432/omniops_db

# Security & Sandboxing
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=256
AGENT_DEFAULT_MAX_STEPS=12
AGENT_HARD_MAX_STEPS=20
AGENT_LOOP_DETECTION_THRESHOLD=2

# LLM Providers (auto, openai, gemini, analytical)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_SCHEMA_DIMENSION=1536
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
