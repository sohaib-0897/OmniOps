# OmniOps Environment Variables

# App Environment
ENVIRONMENT=development
DEBUG=False
PROJECT_NAME="OmniOps"
# In production, generate a secure secret: `openssl rand -hex 32`
SECRET_KEY=replace_with_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000"]
# Production requires COOKIE_SECURE=true and HTTPS-only CORS origins.

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://omniops:omniops_secure_pass@localhost:5432/omniops_db

# Security & Sandboxing
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MAX_PIDS=32
SANDBOX_MAX_STDOUT_BYTES=65536
SANDBOX_MAX_STDERR_BYTES=65536
SANDBOX_MAX_OUTPUT_BYTES=262144
SANDBOX_MAX_ARTIFACTS=10
SANDBOX_IMAGE=omniops-python-sandbox:2026.09.05
# Production: point this at the dedicated internal runner service. Do not
# mount the Docker socket into the web/backend container.
# Production-safe default: use a separately deployed authenticated runner.
# For local Docker convenience, run with docker-compose.dev.yml instead.
SANDBOX_EXECUTION_MODE=remote
SANDBOX_RUNNER_URL=
SANDBOX_RUNNER_TOKEN=
AGENT_DEFAULT_MAX_STEPS=12
AGENT_HARD_MAX_STEPS=20
AGENT_LOOP_DETECTION_THRESHOLD=2

# LLM Providers (auto, openai, gemini, analytical)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_SCHEMA_DIMENSION=1536
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
ANTHROPIC_API_KEY=

# Outbound web retrieval policy
WEB_ALLOWED_SCHEMES=["http","https"]
WEB_ALLOWED_PORTS=[80,443]
WEB_CONNECT_TIMEOUT_SECONDS=5
WEB_READ_TIMEOUT_SECONDS=10
WEB_TOTAL_TIMEOUT_SECONDS=20
WEB_MAX_REDIRECTS=3
WEB_MAX_RESPONSE_BYTES=2097152
WEB_MAX_DECODED_BYTES=2097152
WEB_ALLOWED_CONTENT_TYPES=["text/html","application/xhtml+xml","text/plain"]

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
